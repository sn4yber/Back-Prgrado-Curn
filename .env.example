# ─── Server ───────────────────────────────────────────────
APP_PORT=8080
APP_ENV=development

# ─── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=curn_networking
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ─── Argon2id ─────────────────────────────────────────────
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
ARGON2_KEY_LENGTH=32

# ─── Auth ─────────────────────────────────────────────────
# Permite registrar sin enviar program_id en el body.
# Debe existir en la tabla programs.
AUTH_DEFAULT_PROGRAM_ID=0a3e24e6-4cbf-4214-a828-10a59e709a24

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=1m

# ─── Production helpers (optional) ─────────────────────────
# Imagen a usar en docker-compose.prod.yml
API_IMAGE=curn-api:latest

